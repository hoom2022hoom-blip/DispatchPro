# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Google AI (Genkit / Gemini)
GEMINI_API_KEY=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Nodemailer (for sending email invites)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Opt-in ASP.NET reception provider (set before dev/build; unset keeps the existing provider)
NEXT_PUBLIC_RECEPTION_BACKEND=""
# Server-side API address; HTTPS required for remote hosts
DISPATCHPRO_API_URL="http://127.0.0.1:9010"
# Standalone worker only; never use NEXT_PUBLIC for its credentials
DISPATCHPRO_WORKER_TENANT=""
DISPATCHPRO_WORKER_USERNAME=""
DISPATCHPRO_WORKER_PASSWORD=""
# Optional: same local journal directory used by /api/calls
DISPATCHPRO_LOCAL_DATA_DIR=""
